APP_NAME="Cemetery Reservation System"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cemetery_db
DB_USERNAME=cemetery_user
DB_PASSWORD=secret

# Cemetery time for PHP and MySQL: dates, created_at and audit times.
APP_TIMEZONE=Asia/Manila
# Pending requests one visitor may hold at once (0 = no limit).
RESERVATION_MAX_PENDING=3
# Days an unpaid pending request holds its plot before it expires (0 = never).
RESERVATION_HOLD_DAYS=7
